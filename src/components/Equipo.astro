---
const equipo = [
  // Kinesiología
  { nombre: "Francisca Avila",      iniciales: "FA", especialidad: "Kinesióloga",                         area: "kinesio" },
  { nombre: "Felipe Cachón",        iniciales: "FC", especialidad: "Kinesiólogo · Quiropráctico EPI",      area: "kinesio" },
  { nombre: "Francisco Bladayoll",  iniciales: "FB", especialidad: "Kinesiólogo",                          area: "kinesio" },
  { nombre: "Sebastián Varas",      iniciales: "SV", especialidad: "Kinesiólogo",                          area: "kinesio" },
  { nombre: "Tomás Michael",        iniciales: "TM", especialidad: "Kinesiólogo",                          area: "kinesio" },
  { nombre: "Paz Mesa",             iniciales: "PM", especialidad: "Kinesióloga",                          area: "kinesio" },
  { nombre: "Orlando Dassonville",  iniciales: "OD", especialidad: "Kinesiólogo · Piso Pélvico",           area: "kinesio" },
  { nombre: "Paulina Calderón",     iniciales: "PC", especialidad: "Kinesióloga · Piso Pélvico",           area: "kinesio" },
  { nombre: "Juan Carlos Bravo",    iniciales: "JB", especialidad: "Kinesiólogo · Acupunturista",          area: "kinesio" },
  { nombre: "Gonzalo Requena",      iniciales: "GR", especialidad: "Kinesiólogo · Quiropráctica",          area: "kinesio" },
  { nombre: "Javiera Matus",        iniciales: "JM", especialidad: "Kinesióloga · Instructora Pilates",    area: "kinesio" },
  // Médico
  { nombre: "Jean Romagnolli",      iniciales: "JR", especialidad: "Médico Cirujano · Medicina Deportiva", area: "medico"  },
  { nombre: "María Luisa Bravo",    iniciales: "ML", especialidad: "Médico Cirujano · Medicina Familiar",  area: "medico"  },
  // Bienestar
  { nombre: "Valentina Torres",     iniciales: "VT", especialidad: "Nutricionista",                        area: "bienestar" },
  { nombre: "Francisca Garrido",    iniciales: "FG", especialidad: "Nutricionista",                        area: "bienestar" },
  { nombre: "Gisselle Carbone",     iniciales: "GC", especialidad: "Masoterapueta",                        area: "bienestar" },
  // Fitness
  { nombre: "Etienne Ducret",       iniciales: "ED", especialidad: "Instructor Ninjutsu",                  area: "fitness" },
  { nombre: "Marcela González",     iniciales: "MG", especialidad: "Instructora Pilates",                  area: "fitness" },
  { nombre: "Yerson Morales",       iniciales: "YM", especialidad: "Instructor Zumba",                     area: "fitness" },
  { nombre: "Claudio Tilleria",     iniciales: "CT", especialidad: "Preparador Físico · Masoterapueta",    area: "fitness" },
  // Administración
  { nombre: "Adriana Mafia",        iniciales: "AM", especialidad: "Recepcionista",                        area: "admin"   },
  { nombre: "Alejandra Cornejo",    iniciales: "AC", especialidad: "Recepcionista",                        area: "admin"   },
  { nombre: "Edith Meneses",        iniciales: "EM", especialidad: "Auxiliar",                             area: "admin"   },
  { nombre: "William Veloso",       iniciales: "WV", especialidad: "Gerente General",                      area: "admin"   },
];

const tabs = [
  { id: "todos",     label: "Todos" },
  { id: "kinesio",  label: "Kinesiología" },
  { id: "medico",   label: "Médico" },
  { id: "bienestar",label: "Bienestar" },
  { id: "fitness",  label: "Fitness" },
  { id: "admin",    label: "Administración" },
];
---

<section id="equipo" class="equipo">
  <div class="container">

    <div class="equipo-header">
      <div>
        <span class="equipo-tag">Nuestro equipo</span>
        <h2 class="section-title">Un equipo que acompañará<br/>cada uno de tus desafíos.</h2>
      </div>
      <p class="section-subtitle">
        Profesionales comprometidos que trabajan de forma coordinada para ofrecerte
        la mejor atención en cada etapa de tu tratamiento.
      </p>
    </div>

    <!-- Tabs de filtro -->
    <div class="equipo-tabs" role="tablist">
      {tabs.map((t) => (
        <button role="tab" class={`tab-btn ${t.id === 'todos' ? 'active' : ''}`} data-filter={t.id}>
          {t.label}
        </button>
      ))}
    </div>

    <!-- Grid de equipo -->
    <div class="equipo-grid" id="equipo-grid">
      {equipo.map((p) => (
        <div class="profesional-card" data-area={p.area}>
          <div class="prof-avatar">
            <span class="prof-iniciales">{p.iniciales}</span>
          </div>
          <p class="prof-nombre">{p.nombre}</p>
          <p class="prof-especialidad">{p.especialidad}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.profesional-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      cards.forEach(card => {
        const show = filter === 'todos' || card.getAttribute('data-area') === filter;
        (card as HTMLElement).style.display = show ? 'flex' : 'none';
      });
    });
  });
</script>

<style>
  .equipo {
    background: var(--color-bg);
    padding: var(--section-padding);
  }

  .equipo-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .equipo-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  /* Tabs */
  .equipo-tabs {
    display: flex;
    gap: 0;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tab-btn {
    padding: 0.65rem 1.25rem;
    border: none;
    background: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.2s, border-color 0.2s;
    font-family: var(--font-body);
  }

  .tab-btn:hover { color: var(--color-primary); }

  .tab-btn.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  /* Grid */
  .equipo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 1.75rem 1.25rem;
  }

  .profesional-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    cursor: default;
    transition: transform 0.2s;
  }

  .profesional-card:hover { transform: translateY(-3px); }

  /* Avatar circular */
  .prof-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-teal-dark) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 3px solid var(--color-white);
    box-shadow: 0 4px 16px rgba(17,187,191,0.2);
    transition: box-shadow 0.2s;
  }

  .profesional-card:hover .prof-avatar {
    box-shadow: 0 6px 24px rgba(17,187,191,0.35);
  }

  /* Diferentes colores por área */
  .profesional-card[data-area="medico"] .prof-avatar {
    background: linear-gradient(135deg, #1A6FA8 0%, #0E9EA2 100%);
  }

  .profesional-card[data-area="bienestar"] .prof-avatar {
    background: linear-gradient(135deg, #2E9C5E 0%, #11BBBF 100%);
  }

  .profesional-card[data-area="fitness"] .prof-avatar {
    background: linear-gradient(135deg, var(--color-accent) 0%, #D97500 100%);
  }

  .profesional-card[data-area="admin"] .prof-avatar {
    background: linear-gradient(135deg, #5A6170 0%, #3D4451 100%);
  }

  .prof-iniciales {
    color: var(--color-white);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .prof-nombre {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.3;
  }

  .prof-especialidad {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .equipo-header { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  @media (max-width: 600px) {
    .equipo-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 1.5rem 1rem; }
    .prof-avatar { width: 72px; height: 72px; }
    .prof-iniciales { font-size: 0.875rem; }
  }
</style>
