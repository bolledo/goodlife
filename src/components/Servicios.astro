      <button class="area-tab" data-area="gimnasio" role="tab">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6.5 6.5h11M6.5 17.5h11M3 12h18M7 8.5V6a1 1 0 011-1h1a1 1 0 011 1v11a1 1 0 01-1 1H8a1 1 0 01-1-1v-2.5M17 8.5V6a1 1 0 00-1-1h-1a1 1 0 00-1 1v11a1 1 0 001 1h1a1 1 0 001-1v-2.5"/></svg>
        Gimnasio
      </button>
      <button class="area-tab" data-area="fitness" role="tab">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Espacio Fitness
