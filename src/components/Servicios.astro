---
const servicios = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4.5 12.75l6 6 9-13.5"/></svg>`,
    nombre: "Kinesiología Traumatológica",
    desc: "Recuperación de lesiones musculares, articulares y post-quirúrgicas con técnicas actualizadas.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    nombre: "Kinesiología Deportiva",
    desc: "Tratamiento especializado para deportistas. Desde la lesión hasta el regreso al deporte.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
    nombre: "Reintegro Deportivo",
    desc: "Protocolo progresivo y seguro para volver a la actividad física tras una lesión.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 11.5V14m0-2.5V6a1.5 1.5 0 113 0m-3 5.5a1.5 1.5 0 00-3 0V14m6-5a1.5 1.5 0 00-3 0m3 0a1.5 1.5 0 013 0v.5m0 0V14a1.5 1.5 0 01-3 0m3-5.5a1.5 1.5 0 00-1.5 1.5"/></svg>`,
    nombre: "Masoterapia",
    desc: "Técnicas manuales para alivio de tensiones, dolor muscular y mejora de la circulación.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    nombre: "Quiropraxia",
    desc: "Ajustes vertebrales y articulares para alivio del dolor y mejora de la movilidad.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    nombre: "Rehab. Cardiometabólica",
    desc: "Programas supervisados para pacientes con enfermedades cardiovasculares y metabólicas.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    nombre: "Kinesiología a Domicilio",
    desc: "Atención en tu hogar para mayor comodidad cuando el traslado es difícil.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>`,
