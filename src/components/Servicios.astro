    desc: "Apoyo para recuperar independencia en actividades cotidianas tras una lesión o enfermedad.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0112 0v2"/></svg>`,
    nombre: "Psicología",
    desc: "Acompañamiento psicológico para el bienestar emocional y mental.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>`,
    nombre: "Nutrición",
    desc: "Planes nutricionales personalizados para mejorar tu salud y rendimiento.",
    href: "#contacto",
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 3l14 9-14 9V3z"/></svg>`,
    nombre: "Bienestar y Belleza",
    desc: "Tratamientos estéticos y de bienestar para cuidar tu cuerpo de forma integral.",
    href: "#contacto",
  },
];
---

<section id="servicios" class="servicios">
  <div class="container">

    <div class="servicios-intro">
      <div class="intro-left">
        <span class="servicios-tag">Nuestros servicios</span>
        <h2 class="section-title">Atención integral,<br/>en cada etapa.</h2>
      </div>
      <div class="intro-right">
        <p class="intro-quote">
          "No tratamos solo la lesión — acompañamos al paciente en todo su proceso,
          desde el diagnóstico hasta la plena recuperación y el bienestar a largo plazo."
        </p>
      </div>
    </div>

    <div class="servicios-grid">
      {servicios.map((s) => (
        <a href={s.href} class="servicio-card">
          <div class="servicio-icon" set:html={s.icon} />
          <div class="servicio-body">
            <h3 class="servicio-nombre">{s.nombre}</h3>
            <p class="servicio-desc">{s.desc}</p>
          </div>
          <span class="servicio-link">
            Consultar
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .servicios {
    background: var(--color-white);
    padding: var(--section-padding);
  }

  .servicios-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .servicios-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .intro-quote {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    font-style: italic;
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .servicio-card {
    background: var(--color-white);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.2s;
    cursor: pointer;
  }

  .servicio-card:hover {
    background: var(--color-bg);
  }

  .servicio-card:hover .servicio-link {
    color: var(--color-primary-dark);
    gap: 0.5rem;
  }

  .servicio-icon {
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .servicio-body { flex: 1; }

  .servicio-nombre {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .servicio-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .servicio-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
    transition: gap 0.2s, color 0.2s;
  }

  @media (max-width: 768px) {
    .servicios-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
