<script>
  const tabs = document.querySelectorAll('.area-tab:not([disabled])');
  const panels = document.querySelectorAll('.area-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const area = tab.getAttribute('data-area');

      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      panels.forEach(p => p.classList.add('hidden'));
      document.getElementById(`panel-${area}`)?.classList.remove('hidden');
    });
  });
</script>

<style>
  .servicios {
    background: var(--color-white);
    padding: var(--section-padding);
  }

  .servicios-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .servicios-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .intro-quote {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    font-style: italic;
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
  }

  /* Area tabs */
  .area-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .area-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-body);
  }

  .area-tab:hover:not([disabled]) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .area-tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .area-tab--soon {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .soon-badge {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
    margin-left: 0.25rem;
  }

  .hidden { display: none; }

  /* ---- Panel Salud ---- */
  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .servicio-card {
    background: var(--color-white);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.2s;
    cursor: pointer;
  }

  .servicio-card:hover { background: var(--color-bg); }
  .servicio-card:hover .servicio-link { color: var(--color-primary-dark); gap: 0.5rem; }

  .servicio-icon { color: var(--color-primary); margin-bottom: 0.25rem; }
  .servicio-body { flex: 1; }

  .servicio-nombre {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .servicio-desc {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .servicio-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: auto;
    transition: gap 0.2s, color 0.2s;
  }

  /* ---- Panel Gimnasio ---- */
  .gimnasio-layout {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
    align-items: start;
  }

  .gimnasio-hero {
    background: linear-gradient(160deg, #0D1F2D 0%, #0A2A2B 100%);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    color: var(--color-white);
    position: sticky;
