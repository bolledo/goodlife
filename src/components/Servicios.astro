---
const servicios = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.5 12.75l6 6 9-13.5"/></svg>`,
    nombre: "Kinesiología Traumatológica",
    desc: "Recuperación de lesiones musculares, articulares y post-quirúrgicas con técnicas actualizadas.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    nombre: "Kinesiología Deportiva",
    desc: "Tratamiento especializado para deportistas. Desde la lesión hasta el regreso al deporte.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 6v4l3 3"/></svg>`,
    nombre: "Reintegro Deportivo",
    desc: "Protocolo progresivo y seguro para volver a la actividad física tras una lesión.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    nombre: "Masoterapia",
    desc: "Técnicas manuales para alivio de tensiones, dolor muscular y mejora de la circulación.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    nombre: "Quiropraxia",
    desc: "Ajustes vertebrales y articulares para alivio del dolor y mejora de la movilidad.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
    nombre: "Rehab. Cardiometabólica",
    desc: "Programas supervisados para pacientes con enfermedades cardiovasculares y metabólicas.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
    nombre: "Kinesiología a Domicilio",
    desc: "Atención en tu hogar para mayor comodidad cuando el traslado es difícil.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>`,
    nombre: "Fonoaudiología",
    desc: "Evaluación y tratamiento de trastornos del habla, voz, lenguaje y deglución.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    nombre: "Terapia Ocupacional",
    desc: "Apoyo para recuperar independencia en actividades cotidianas tras una lesión o enfermedad.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0112 0v2"/></svg>`,
    nombre: "Psicología",
    desc: "Acompañamiento psicológico para el bienestar emocional y mental.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>`,
    nombre: "Nutrición",
    desc: "Planes nutricionales personalizados para mejorar tu salud y rendimiento.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3l14 9-14 9V3z"/></svg>`,
    nombre: "Bienestar y Belleza",
    desc: "Tratamientos estéticos y de bienestar para cuidar tu cuerpo de forma integral.",
  },
];
---

<section id="servicios" class="servicios">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Nuestros servicios</h2>
      <p class="section-subtitle">
        Atención integral con profesionales especializados en cada área de la salud.
      </p>
    </div>

    <div class="servicios-grid">
      {servicios.map((s) => (
        <div class="servicio-card">
          <div class="servicio-icon" set:html={s.icon} />
          <h3 class="servicio-nombre">{s.nombre}</h3>
          <p class="servicio-desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="servicios-cta">
      <p>¿No encontrás lo que necesitás? Consúltanos directamente.</p>
      <a href="https://wa.me/56939489688" target="_blank" rel="noopener" class="btn btn-primary">
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .servicios {
    background: var(--color-white);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header .section-subtitle {
    margin-top: 0.75rem;
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .servicio-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .servicio-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }

  .servicio-icon {
    width: 52px;
    height: 52px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .servicio-nombre {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .servicio-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .servicios-cta {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .servicios-cta p {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    .servicios-cta {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
