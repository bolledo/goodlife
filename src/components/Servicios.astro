      </button>
    </div>

    <!-- Panel: Salud -->
    <div class="area-panel" id="panel-salud">
      <div class="servicios-grid">
        {serviciosSalud.map((s) => (
          <a href="#contacto" class="servicio-card">
            <div class="servicio-icon" set:html={s.icon} />
            <div class="servicio-body">
