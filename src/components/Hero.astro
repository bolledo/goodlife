<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-badge">Desde 2010 en Huechuraba</span>
      <h1 class="hero-title">
        Tu salud y recuperación<br />
        <span class="hero-highlight">en buenas manos</span>
      </h1>
      <p class="hero-desc">
        Somos un centro integral de kinesiología, rehabilitación y bienestar.
        Te acompañamos desde la recuperación hasta el alto rendimiento deportivo.
      </p>
      <div class="hero-actions">
        <a href="https://wa.me/56939489688?text=Hola%2C%20quisiera%20agendar%20una%20hora" target="_blank" rel="noopener" class="btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          Agendar hora
        </a>
        <a href="#servicios" class="btn btn-outline">Ver servicios</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">+14</span>
          <span class="stat-label">años de experiencia</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">9</span>
          <span class="stat-label">profesionales</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">13</span>
          <span class="stat-label">especialidades</span>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-card hero-card-main">
        <div class="hero-icon-wrap">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <p>Atención personalizada y de calidad</p>
      </div>
      <div class="hero-card hero-card-hours">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div>
          <strong>Lun – Vie</strong>
          <span>8:00 – 21:00</span>
        </div>
        <div>
          <strong>Sábado</strong>
          <span>9:00 – 14:00</span>
        </div>
      </div>
      <div class="hero-blob"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
    padding: 4rem 1.5rem 5rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  .hero-badge {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    color: var(--color-text);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-highlight {
    color: var(--color-primary);
  }

  .hero-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stat { display: flex; flex-direction: column; }
  .stat-num { font-size: 1.6rem; font-weight: 800; color: var(--color-primary); line-height: 1; }
  .stat-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 2px; }
  .stat-divider { width: 1px; height: 36px; background: var(--color-border); }

  /* Visual side */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
  }

  .hero-blob {
    position: absolute;
    width: 340px;
    height: 340px;
    background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);
    opacity: 0.15;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
  }

  .hero-card {
    position: relative;
    z-index: 1;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: 1.5rem;
    border: 1px solid var(--color-border);
  }

  .hero-card-main {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 340px;
  }

  .hero-icon-wrap {
    width: 64px;
    height: 64px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .hero-card-main p {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
  }

  .hero-card-hours {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 340px;
    color: var(--color-primary);
  }

  .hero-card-hours > svg { flex-shrink: 0; }

  .hero-card-hours div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-card-hours strong {
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .hero-card-hours span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-visual {
      align-items: center;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-card-main,
    .hero-card-hours {
      max-width: 280px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; }
    .hero-stats { gap: 1rem; }
  }
</style>
