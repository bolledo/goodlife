---
const accesos = [
  {
    label: "Salud",
    sublabel: "Kinesiología · Rehab · Bienestar",
    area: "salud",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>`,
  },
  {
    label: "Gimnasio",
    sublabel: "Entrenamiento semipersonalizado",
    area: "gimnasio",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.5 6.5h11M6.5 17.5h11M3 12h18M7 8.5V6a1 1 0 011-1h1a1 1 0 011 1v11a1 1 0 01-1 1H8a1 1 0 01-1-1v-2.5M17 8.5V6a1 1 0 00-1-1h-1a1 1 0 00-1 1v11a1 1 0 001 1h1a1 1 0 001-1v-2.5"/></svg>`,
  },
  {
    label: "Espacio Fitness",
    sublabel: "Zumba · Pilates · HIT · Ninjutsu",
    area: "fitness",
    badge: "NUEVO",
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
];
---

<section class="hero">
  <div class="hero-top">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="hero-badge">Desde 2010 · Huechuraba, Santiago</span>
        <h1 class="hero-title">
          PREVENCIÓN. DIAGNÓSTICO.<br/>
          <span class="hero-highlight">REHABILITACIÓN. BIENESTAR.</span>
        </h1>
        <p class="hero-desc">
          Centro integral de kinesiología y salud. Te acompañamos desde la lesión
          hasta el pleno rendimiento, con un equipo de 9 profesionales especializados.
        </p>
        <div class="hero-actions">
          <a href="https://wa.me/56939489688?text=Hola%2C%20quisiera%20agendar%20una%20hora" target="_blank" rel="noopener" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
            Agendar hora
          </a>
          <a href="#servicios" class="btn btn-outline">Ver servicios</a>
        </div>
      </div>
      <div class="hero-hours-card">
        <div class="hours-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <span>Lun – Vie</span>
            <strong>8:00 – 21:00</strong>
          </div>
        </div>
        <div class="hours-divider"></div>
        <div class="hours-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <span>Sábado</span>
            <strong>9:00 – 14:00</strong>
          </div>
        </div>
        <a href="https://wa.me/56939489688" target="_blank" rel="noopener" class="hours-wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          +56 9 3948 9688
        </a>
      </div>
    </div>
  </div>

  <!-- Accesos directos a áreas de servicio -->
  <div class="hero-grid-bar">
    <div class="container">
      <div class="accesos-grid">
        {accesos.map((a) => (
          <a href="#servicios" class="acceso-item" data-area={a.area}>
            <div class="acceso-icon" set:html={a.icon} />
            <div class="acceso-body">
              <span class="acceso-label">
                {a.label}
                {a.badge && <span class="acceso-badge">{a.badge}</span>}
              </span>
              <span class="acceso-sublabel">{a.sublabel}</span>
            </div>
            <svg class="acceso-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.acceso-item[data-area]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const area = link.getAttribute('data-area');
      const section = document.getElementById('servicios');
      if (!section) return;

      // Activate the matching tab
      const tab = section.querySelector(`.area-tab[data-area="${area}"]`);
      if (tab && !tab.disabled) tab.click();

      // Scroll to section
      const offset = 80;
      const top = section.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });
</script>

<style>
  .hero {
    background: linear-gradient(160deg, #0D1F2D 0%, #0A2A2B 100%);
  }

  .hero-top {
    padding: 5rem 1.5rem 4rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 3rem;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .hero-highlight {
    color: var(--color-accent);
  }

  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.7);
    max-width: 500px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-actions .btn-outline {
    color: var(--color-white);
    border-color: rgba(255,255,255,0.3);
  }

  .hero-actions .btn-outline:hover {
    background: rgba(255,255,255,0.1);
    color: var(--color-white);
    border-color: var(--color-white);
  }

  /* Hours card */
  .hero-hours-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 200px;
  }

  .hours-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.5);
  }

  .hours-row div {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hours-row span {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hours-row strong {
    font-size: 1rem;
    color: var(--color-white);
    font-weight: 700;
  }

  .hours-divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
  }

  .hours-wa {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #25D366;
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.25rem;
    transition: opacity 0.2s;
  }

  .hours-wa:hover { opacity: 0.8; }

  /* Accesos grid bar */
  .hero-grid-bar {
    background: var(--color-teal-dark);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 0;
  }

  .accesos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .acceso-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 1.75rem;
    color: rgba(255,255,255,0.75);
    border-right: 1px solid rgba(255,255,255,0.08);
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }

  .acceso-item:last-child { border-right: none; }

  .acceso-item:hover {
    background: rgba(255,255,255,0.08);
    color: var(--color-white);
  }

  .acceso-item:hover .acceso-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  .acceso-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    background: rgba(255,139,0,0.12);
    border-radius: 10px;
  }

  .acceso-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .acceso-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .acceso-badge {
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-accent);
    color: var(--color-white);
    padding: 0.15rem 0.45rem;
    border-radius: 100px;
  }

  .acceso-sublabel {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.01em;
  }

  .acceso-arrow {
    flex-shrink: 0;
    color: rgba(255,255,255,0.3);
    transition: transform 0.2s, color 0.2s;
  }

  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-hours-card { flex-direction: row; flex-wrap: wrap; gap: 1rem; }
    .hours-divider { width: 1px; height: auto; }
    .accesos-grid { grid-template-columns: 1fr; }
    .acceso-item { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .acceso-item:last-child { border-bottom: none; }
  }

  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; }
    .acceso-item { padding: 1.1rem 1.25rem; }
  }
</style>
