---
const accesos = [
  { label: "Kinesiología\nTraumatológica", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.5 12.75l6 6 9-13.5"/></svg>` },
  { label: "Kinesiología\nDeportiva", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { label: "Reintegro\nDeportivo", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>` },
  { label: "Masoterapia", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 11.5V14m0-2.5V6a1.5 1.5 0 113 0m-3 5.5a1.5 1.5 0 00-3 0V14m6-5a1.5 1.5 0 00-3 0m3 0a1.5 1.5 0 013 0v.5m0 0V14a1.5 1.5 0 01-3 0m3-5.5a1.5 1.5 0 00-1.5 1.5"/></svg>` },
  { label: "Quiropraxia", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 14v-4m0-4h.01"/></svg>` },
  { label: "Rehab.\nCardiometabólica", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>` },
  { label: "Atención\na Domicilio", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>` },
  { label: "Nutrición &\nBienestar", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>` },
  { label: "Fonoaudiología\n& Psicología", icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>` },
];
---

<section class="hero">
  <div class="hero-top">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="hero-badge">Desde 2010 · Huechuraba, Santiago</span>
        <h1 class="hero-title">
          PREVENCIÓN. DIAGNÓSTICO.<br/>
          <span class="hero-highlight">REHABILITACIÓN. BIENESTAR.</span>
        </h1>
        <p class="hero-desc">
          Centro integral de kinesiología y salud. Te acompañamos desde la lesión
          hasta el pleno rendimiento, con un equipo de 9 profesionales especializados.
        </p>
        <div class="hero-actions">
          <a href="https://wa.me/56939489688?text=Hola%2C%20quisiera%20agendar%20una%20hora" target="_blank" rel="noopener" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
            Agendar hora
          </a>
          <a href="#servicios" class="btn btn-outline">Ver servicios</a>
        </div>
      </div>
      <div class="hero-hours-card">
        <div class="hours-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <span>Lun – Vie</span>
            <strong>8:00 – 21:00</strong>
          </div>
        </div>
        <div class="hours-divider"></div>
        <div class="hours-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <span>Sábado</span>
            <strong>9:00 – 14:00</strong>
          </div>
        </div>
        <a href="https://wa.me/56939489688" target="_blank" rel="noopener" class="hours-wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          +56 9 3948 9688
        </a>
      </div>
    </div>
  </div>

  <!-- Grid de accesos rápidos estilo Isokinetic -->
  <div class="hero-grid-bar">
    <div class="container">
      <div class="accesos-grid">
        {accesos.map((a) => (
          <a href="#servicios" class="acceso-item">
            <div class="acceso-icon" set:html={a.icon} />
            <span class="acceso-label">{a.label}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, #0D1F2D 0%, #0A2A2B 100%);
  }

  .hero-top {
    padding: 5rem 1.5rem 4rem;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 3rem;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--color-white);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .hero-highlight {
    color: var(--color-accent);
  }

  .hero-desc {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.7);
    max-width: 500px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-actions .btn-outline {
    color: var(--color-white);
    border-color: rgba(255,255,255,0.3);
  }

  .hero-actions .btn-outline:hover {
    background: rgba(255,255,255,0.1);
    color: var(--color-white);
    border-color: var(--color-white);
  }

  /* Hours card */
  .hero-hours-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 200px;
  }

  .hours-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.5);
  }

  .hours-row div {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hours-row span {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hours-row strong {
    font-size: 1rem;
    color: var(--color-white);
    font-weight: 700;
  }

  .hours-divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
  }

  .hours-wa {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #25D366;
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: 0.25rem;
    transition: opacity 0.2s;
  }

  .hours-wa:hover { opacity: 0.8; }

  /* Accesos grid bar */
  .hero-grid-bar {
    background: var(--color-teal-dark);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 0;
  }

  .accesos-grid {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
  }

  .acceso-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.25rem 0.75rem;
    color: rgba(255,255,255,0.75);
    text-align: center;
    border-right: 1px solid rgba(255,255,255,0.08);
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }

  .acceso-item:last-child { border-right: none; }

  .acceso-item:hover {
    background: rgba(255,255,255,0.08);
    color: var(--color-white);
  }

  .acceso-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }

  .acceso-label {
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: pre-line;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  @media (max-width: 1100px) {
    .accesos-grid { grid-template-columns: repeat(5, 1fr); }
    .acceso-item:nth-child(5) { border-right: none; }
    .acceso-item:nth-child(n+6) { border-top: 1px solid rgba(255,255,255,0.08); }
  }

  @media (max-width: 768px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-hours-card { flex-direction: row; flex-wrap: wrap; gap: 1rem; }
    .hours-divider { width: 1px; height: auto; }
    .accesos-grid { grid-template-columns: repeat(3, 1fr); }
    .acceso-item:nth-child(3n) { border-right: none; }
    .acceso-item:nth-child(n+4) { border-top: 1px solid rgba(255,255,255,0.08); }
  }

  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; }
    .accesos-grid { grid-template-columns: repeat(2, 1fr); }
    .acceso-item:nth-child(2n) { border-right: none; }
    .acceso-item:nth-child(3n) { border-right: 1px solid rgba(255,255,255,0.08); }
    .acceso-item:nth-child(2n) { border-right: none; }
  }
</style>
