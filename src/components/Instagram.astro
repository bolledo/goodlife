---
// INSTRUCCIONES PARA ACTIVAR:
// 1. Crear cuenta gratis en behold.so
// 2. Conectar Instagram @goodlifehuechuraba y crear un feed
// 3. Reemplazar "TU_FEED_ID_AQUI" con el ID que te entrega Behold
const feedId = "TU_FEED_ID_AQUI";
const instagramUrl = "https://www.instagram.com/goodlifehuechuraba";
---

<section class="instagram">
  <div class="container">

    <div class="instagram-header">
      <div class="instagram-brand">
        <div class="ig-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div>
          <p class="ig-pretitle">Síguenos en Instagram</p>
          <a href={instagramUrl} target="_blank" rel="noopener" class="ig-handle">
            @goodlifehuechuraba
          </a>
        </div>
      </div>
      <a href={instagramUrl} target="_blank" rel="noopener" class="btn-follow">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Seguir
      </a>
    </div>

    <!-- Widget Behold — se activa al reemplazar TU_FEED_ID_AQUI -->
    {feedId !== "TU_FEED_ID_AQUI" ? (
      <div class="behold-wrap">
        <behold-widget feed-id={feedId}></behold-widget>
      </div>
    ) : (
      <div class="ig-placeholder">
        <div class="ig-placeholder-inner">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <p>El feed de Instagram se activará pronto</p>
          <a href={instagramUrl} target="_blank" rel="noopener" class="ig-placeholder-link">
            Ver @goodlifehuechuraba en Instagram →
          </a>
        </div>
      </div>
    )}

  </div>
</section>

<script type="module" src="https://w.behold.so/widget.js"></script>

<style>
  .instagram {
    background: var(--color-white);
    padding: var(--section-padding);
    border-top: 1px solid var(--color-border);
  }

  .instagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .instagram-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .ig-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .ig-pretitle {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .ig-handle {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }

  .ig-handle:hover { color: var(--color-primary); }

  .btn-follow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.9rem;
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: white;
    transition: opacity 0.2s, transform 0.2s;
  }

  .btn-follow:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .behold-wrap {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* Placeholder mientras no está configurado Behold */
  .ig-placeholder {
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: 4rem 2rem;
    text-align: center;
  }

  .ig-placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .ig-placeholder-inner p {
    font-size: 1rem;
    font-weight: 500;
  }

  .ig-placeholder-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: color 0.2s;
  }

  .ig-placeholder-link:hover { color: var(--color-primary-dark); }

  @media (max-width: 600px) {
    .instagram-header { flex-direction: column; align-items: flex-start; }
    .btn-follow { width: 100%; justify-content: center; }
  }
</style>
