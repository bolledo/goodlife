---
const year = new Date().getFullYear();

const servicios = [
  "Kinesiología Traumatológica",
  "Kinesiología Deportiva",
  "Masoterapia",
  "Quiropraxia",
  "Fonoaudiología",
  "Nutrición",
  "Terapia Ocupacional",
  "Psicología",
];
---

<footer class="footer">
  <div class="container footer-inner">

    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="logo-gl">Good</span><span class="logo-life">life</span>
      </a>
      <p class="footer-tagline">
        Kinesiología Integral — Acompañándote desde 2010 en tu camino hacia la salud y el bienestar.
      </p>
      <a
        href="https://wa.me/56939489688"
        target="_blank"
        rel="noopener"
        class="footer-wa"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.117 1.526 5.845L.057 23.5l5.818-1.524A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.197-1.378l-.371-.22-3.449.904.921-3.364-.242-.386A9.937 9.937 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        +56 9 3948 9688
      </a>
    </div>

    <div class="footer-col">
      <h4 class="footer-col-title">Servicios</h4>
      <ul class="footer-links">
        {servicios.map((s) => (
          <li><a href="#servicios">{s}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-col-title">Horarios</h4>
      <ul class="footer-hours">
        <li><span>Lunes – Viernes</span><strong>8:00 – 21:00</strong></li>
        <li><span>Sábado</span><strong>9:00 – 14:00</strong></li>
        <li><span>Domingo</span><strong>Cerrado</strong></li>
      </ul>

      <h4 class="footer-col-title" style="margin-top: 1.5rem;">Ubicación</h4>
      <p class="footer-address">
        Santa Marta de Huechuraba 6741<br/>
        Interior Liga La Reina<br/>
        Huechuraba, Santiago
      </p>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {year} Goodlife Kinesiología Integral. Todos los derechos reservados.</p>
      <nav class="footer-bottom-links">
        <a href="#servicios">Servicios</a>
        <a href="#equipo">Equipo</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-text);
    color: rgba(255,255,255,0.75);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding: 4rem 1.5rem 3rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.1rem;
    margin-bottom: 1rem;
  }

  .logo-gl { font-size: 1.5rem; font-weight: 800; color: var(--color-accent); }
  .logo-life { font-size: 1.5rem; font-weight: 800; color: var(--color-white); }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 280px;
  }

  .footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #25D366;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.2s;
  }

  .footer-wa:hover { opacity: 0.8; }

  .footer-col-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--color-accent); }

  .footer-hours {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    gap: 1rem;
  }

  .footer-hours strong { color: var(--color-white); }

  .footer-address {
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom-inner p { font-size: 0.8rem; }

  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom-links a {
    font-size: 0.8rem;
    transition: color 0.2s;
  }

  .footer-bottom-links a:hover { color: var(--color-accent); }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
